# ========================================================
# Mini Gestão - Variáveis de Ambiente
# ========================================================

# Ambiente de execução (development ou production)
NODE_ENV=production

# Porta da aplicação (alterada para 3333 para evitar conflitos com a porta padrão 3000)
PORT=3333
APP_PORT=3333

# Porta externa do PostgreSQL no host (alterada para 5433 para evitar conflito com 5432)
DB_PORT=5433

# Credenciais e banco do PostgreSQL
POSTGRES_USER=app_user
POSTGRES_PASSWORD=senha_segura_123
POSTGRES_DB=mini_gestao

# URL de conexão com o banco de dados
# No Docker Compose e Coolify, a aplicação conecta via rede interna ao host 'database' na porta 5432
DATABASE_URL=postgresql://app_user:senha_segura_123@database:5432/mini_gestao

# Chave secreta e validade da sessão (86400000 ms = 24 horas)
SESSION_SECRET=substitua_por_uma_chave_secreta_longa_e_aleatoria
SESSION_MAX_AGE=86400000

# Defina como 'true' caso utilize domínio com HTTPS (ex: Coolify com Let's Encrypt)
COOKIE_SECURE=false
